#!/usr/bin/env sh
set -eu

image=project-codeigniter-build

docker build --file etc/docker/cli/Dockerfile --tag "$image" .
docker run --rm --volume "$(pwd):/app" --workdir /app "$image" sh -ec '
    # This is an application, not a publishable package: Fight Common is deliberately
    # pinned to an immutable VCS commit for the platform-profile receipt.
    composer validate
    composer install --no-interaction --prefer-dist --no-progress
    php scripts/governance-check.php
    PROJECT_CODEIGNITER_IN_BUILD=1 ./bin/phpunit

    production_root=$(mktemp -d)
    trap "rm -rf \"$production_root\"" EXIT
    cp -a . "$production_root"
    cd "$production_root"
    composer install --no-dev --no-interaction --prefer-dist --no-progress
    php scripts/public-contract-check.php
'
