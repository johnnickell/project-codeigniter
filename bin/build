#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

# Dependency installation is explicit preparation, not a pre-submit test.
./bin/planning-check
./bin/exec sh -ec '
    if [ ! -f vendor/autoload.php ]; then
        echo "Dependencies are missing; run ./bin/composer install before ./bin/build." >&2
        exit 1
    fi

    php scripts/validate-composer.php
    composer check-platform-reqs --no-interaction
    php scripts/verify-composer-runtime-policy.php
    php scripts/governance-check.php
    php scripts/check-php.php
    php vendor/bin/phpcs -s
    php vendor/bin/phpstan analyse --no-progress --memory-limit=512M
    php vendor/bin/deptrac analyse --no-progress --report-uncovered --fail-on-uncovered --cache-file=.runs/cache/deptrac.cache
    php vendor/bin/deptrac debug:unassigned --cache-file=.runs/cache/deptrac.cache
    php vendor/bin/rector process --dry-run --no-progress-bar
    php vendor/bin/phpunit --no-coverage

    CI_ENVIRONMENT=production \
    fightcommon_jwtSecret=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    fightcommon_mercureUrl=https://mercure.example.test/.well-known/mercure \
    fightcommon_mercureJwt=header.payload.signature \
    fightcommon_twilioAccountSid=AC00000000000000000000000000000000 \
    fightcommon_twilioAuthToken=test-auth-token \
    php scripts/verify-production-profile.php
    php scripts/public-contract-check.php
'
