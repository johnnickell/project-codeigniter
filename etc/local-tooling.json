{
  "project": "project-codeigniter",
  "running": [
    "app"
  ],
  "gate": [
    "./bin/.build-full"
  ],
  "outputs": [
    "var/reports",
    "writable/cache",
    "writable/logs"
  ],
  "runtime_probes": [
    [
      "exec",
      "-T",
      "app",
      "sh",
      "-ec",
      "php -r 'echo json_encode([PHP_VERSION, get_loaded_extensions(), ini_get_all(null, false)]);'; composer --version; git --version"
    ]
  ],
  "directories": [
    "var/cache"
  ],
  "images": [
    "app",
    "web"
  ]
}
